---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('transversales', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts[0];
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base>
  <section class="container hero">
    <span class="label">Ingeniera de IA</span>
    <h1>No todo se soluciona con IA. Saber <span class="destacado">cuándo</span> usarla y cómo, es mi trabajo.</h1>
    <p class="bio">Implemento sistemas de IA con desarrollo propio o integrando herramientas de terceros.</p>
    {latest && <a class="btn btn-primario" href={`/transversales/${latest.id}/`}>Leer el último artículo</a>}
  </section>

  {latest && (
    <section class="container latest" aria-labelledby="latest-title">
      <span class="label">Último en Transversales · <span class="dato">{fmt.format(latest.data.date)}</span></span>
      <h2 id="latest-title"><a href={`/transversales/${latest.id}/`}>{latest.data.title}</a></h2>
      <p>{latest.data.description}</p>
    </section>
  )}
</Base>

<style>
  .hero { padding-block: var(--space-16) var(--space-12); display: grid; justify-items: start; gap: var(--space-4); }
  .hero h1 { margin: 0; max-width: 22ch; }
  .bio { font-size: var(--fs-body-lg); color: var(--color-text-secondary); max-width: 40ch; margin: 0 0 var(--space-4); }

  .latest { padding-block: var(--space-8); border-top: 1px solid var(--color-border); }
  .latest h2 { font-size: var(--fs-h3); margin: var(--space-3) 0 var(--space-2); }
  .latest h2 a { color: var(--color-text); text-decoration: none; }
  .latest h2 a:hover { color: var(--color-link); }
  .latest p { margin: 0; max-width: 65ch; color: var(--color-text-secondary); }
</style>
